+// Joins a mesh communicator: one socket to every other rank, so the reduction needs no backend
+// communicator at any world size. A rank listens for the ranks above it and connects to the
+// ranks below it, at the address the client picked for that pair (see comm_pick_host), so each
+// link can run over the interface the two servers share and get its own transport upgrade.
+bool rpc_server::comm_init_mesh(const rpc_msg_comm_init_mesh_req & request, rpc_msg_comm_init_rsp & response) {
+    response.ok = 0;
+    if (request.device >= backends.size() || request.world < 2 || request.world > RPC_COMM_MAX_RANKS ||
+        request.rank >= request.world) {
+        return true;
+    }
+    const uint32_t dev_id = request.device;
+    const uint32_t rank   = request.rank;
+    const uint32_t world  = request.world;
+    comm_state & state = comm_states[dev_id];
+    if (state.allreduce_fn != nullptr) {
         response.ok = 1;
         return true;
     }
 
-    // No backend communicator, so fall back to the pairwise exchange, which only covers two ranks.
-    if (request.world != 2) {
-        LOG_ERROR("[%s] world size %u requires a backend communicator\n", __func__, request.world);
-        state.peers.clear();
