+    // the ranks below it, so allow for their connect retries before giving up.
+    const int accept_timeout_ms = 10000 + 5000 * (int) world;
+    for (uint32_t n = rank + 1; n < world; n++) {
+        socket_ptr peer = srv->accept(accept_timeout_ms);
+        uint32_t peer_rank = 0;
