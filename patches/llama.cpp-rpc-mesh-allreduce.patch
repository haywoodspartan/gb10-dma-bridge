+        // the link speed in Mb/s; virtual and wireless interfaces report none
+        char path[128];
+        snprintf(path, sizeof(path), "/sys/class/net/%s/speed", ifa->ifa_name);
+        if (FILE * f = fopen(path, "r")) {
+            long speed = 0;
+            if (fscanf(f, "%ld", &speed) == 1 && speed > 0) {
+                a.speed_mbps = (uint32_t) speed;
+            }
+            fclose(f);
+        }
+#  endif
+    }
+    freeifaddrs(list);
+#else
+    (void) out;
+    (void) max;
+#endif
+    return n;
+}
