+    sync_all_backends();
+
+    // Listen before connecting, so the ranks above can queue up while this one is still busy
+    // with the ranks below.
+    socket_ptr srv;
+    if (rank + 1 < world) {
+        srv = socket_t::create_server("0.0.0.0", request.port);
+        if (srv == nullptr) {
+            LOG_ERROR("[%s] failed to listen on comm port %u\n", __func__, request.port);
+            return true;
+        }
+    }
+
+    std::vector<socket_ptr> links(world);
+    for (uint32_t i = 0; i < rank; i++) {
+        const rpc_comm_peer & lower = request.lower[i];
+        const std::string host(lower.host, strnlen(lower.host, sizeof(lower.host)));
+        socket_ptr peer;
+        // the rank may not be listening yet, retry for a few seconds
+        for (int n = 0; n < 100 && peer == nullptr; n++) {
+            peer = socket_t::connect(host.c_str(), lower.port);
+            if (peer == nullptr) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(50));
+            }
+        }
+        if (peer == nullptr) {
+            LOG_ERROR("[%s] rank %u failed to connect to rank %u at %s:%u\n", __func__, rank, i, host.c_str(), lower.port);
+            return true;
+        }
+        if (!comm_caps_handshake(peer, /*recv_first =*/ false) ||
+            !peer->send_data(&rank, sizeof(rank)) || !peer->flush()) {
+            LOG_ERROR("[%s] rank %u failed the handshake with rank %u at %s:%u\n", __func__, rank, i, host.c_str(), lower.port);
+            return true;
