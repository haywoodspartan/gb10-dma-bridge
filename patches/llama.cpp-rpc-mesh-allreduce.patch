+void rpc_server::comm_addrs(rpc_msg_comm_addrs_rsp & response) {
+    response = {};
+    rpc_local_addr local[RPC_COMM_MAX_ADDRS];
+    const size_t n = rpc_transport_local_addrs(local, RPC_COMM_MAX_ADDRS);
+    for (size_t i = 0; i < n; i++) {
+        memcpy(response.addrs[i].addr, local[i].addr, sizeof(response.addrs[i].addr));
+        response.addrs[i].prefix = local[i].prefix;
+        response.addrs[i].speed  = local[i].speed_mbps;
+    }
+    response.n_addrs = (uint32_t) n;
+}
